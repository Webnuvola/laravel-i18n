{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webnuvola/laravel-i18n",
    "description": "Laravel internationalization package",
    "keywords": ["laravel", "i18n", "php", "translation", "internationalization", "localization"],
    "license": "MIT",
    "authors": [
        {
            "name": "Fabio Cagliero"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^2.0||^4.7"
    },
    "autoload": {
        "psr-4": {
            "Webnuvola\\Laravel\\I18n\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Webnuvola\\Laravel\\I18n\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webnuvola\\Laravel\\I18n\\I18nServiceProvider"
            ],
            "aliases": {
                "I18n": "Webnuvola\\Laravel\\I18n\\Facades\\I18n",
                "I18nRoutes": "Webnuvola\\Laravel\\I18n\\Facades\\I18nRoutes",
                "I18nUrl": "Webnuvola\\Laravel\\I18n\\Facades\\I18nUrl"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
